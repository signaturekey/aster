# Safe local-only examples. Never use these credentials outside your machine.
# Docker Compose reads port/credential variables; it supplies its own internal
# DATABASE_URL using db:5432 (not the host URL below). No host Bun is needed.
API_PORT=3000
WEB_PORT=8080
DB_PORT=55432
TEST_DB_PORT=55433
POSTGRES_USER=aster
POSTGRES_PASSWORD=aster_local_password

# Optional host Bun development. PORT is the host API listener, not API_PORT.
PORT=3000
BETTER_AUTH_SECRET=aster-local-only-secret-change-before-any-sharing-123
# Compose public origin. For Vite development change both to http://localhost:5175.
# If WEB_PORT changes, update both URLs to match it explicitly.
BETTER_AUTH_URL=http://localhost:8080
TRUSTED_ORIGINS=http://localhost:8080
DATABASE_URL=postgresql://aster:aster_local_password@127.0.0.1:55432/aster
# Explicit isolated disposable database; integration commands must reject aster.
TEST_DATABASE_URL=postgresql://aster_test:aster_test_local_password@127.0.0.1:55433/aster_test

# If changing the local password, use URL-safe characters (or percent-encode it
# consistently in URLs). Existing PostgreSQL volumes retain their old password.
