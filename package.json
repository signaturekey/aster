{
  "name": "aster",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "fixtures/*"
  ],
  "scripts": {
    "dev": "bun run --filter @aster/api dev",
    "start": "bun run --filter @aster/api start",
    "build": "bun run build:api && bun run build:client",
    "build:api": "bun run --filter @aster/api build",
    "build:client": "bun run scripts/build-client.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "db:generate": "bun --bun apps/api/node_modules/prisma/build/index.js generate --config apps/api/prisma.config.ts",
    "db:migrate": "bun --bun apps/api/node_modules/prisma/build/index.js migrate deploy --config apps/api/prisma.config.ts",
    "db:seed": "bun apps/api/prisma/seed.ts",
    "test:integration": "bun scripts/test-integration.ts",
    "test": "bun run test:unit",
    "test:unit": "bun test apps/api/tests/unit packages/api-client/tests",
    "test:watch": "bun test --watch apps/api/tests/unit packages/api-client/tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
