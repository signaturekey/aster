{
  "name": "@aster/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./events": "./src/events.ts",
    "./contract": {
      "types": "./src/contract.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --sourcemap=external",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aster/contracts": "workspace:*",
    "@elysiajs/cors": "1.4.1",
    "better-auth": "1.7.14",
    "elysia": "1.4.30",
    "kysely": "0.29.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@elysia/eden": "1.4.10",
    "@types/bun": "1.4.4",
    "@types/pg": "8.20.0"
  }
}
